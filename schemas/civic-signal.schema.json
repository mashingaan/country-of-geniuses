{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/mashingaan/country-of-geniuses/blob/main/schemas/civic-signal.schema.json",
  "title": "Country of Geniuses Civic Signal Protocol envelope",
  "description": "A privacy-safe, human-approved signal envelope for a future government agent or official service adapter.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "protocol",
    "version",
    "message_type",
    "signal_id",
    "created_at",
    "jurisdiction",
    "problem",
    "evidence",
    "routing",
    "duplicate_check",
    "project_check",
    "confidence",
    "proposed_action",
    "privacy",
    "human_confirmation",
    "tracking"
  ],
  "properties": {
    "protocol": {"const": "cog-civic-signal"},
    "version": {"const": "0.1"},
    "message_type": {"type": "string", "enum": ["signal_preview", "submit_civic_signal"]},
    "signal_id": {"type": "string", "pattern": "^cog-signal-[a-z0-9-]+$"},
    "created_at": {"type": "string", "format": "date-time"},
    "jurisdiction": {
      "type": "object",
      "additionalProperties": false,
      "required": ["country_code", "city"],
      "properties": {
        "country_code": {"type": "string", "pattern": "^[A-Z]{2}$"},
        "region": {"type": "string", "maxLength": 120},
        "city": {"type": "string", "minLength": 1, "maxLength": 120},
        "location_label": {"type": "string", "minLength": 1, "maxLength": 240},
        "location_precision": {"type": "string", "enum": ["city", "district", "street", "intersection", "public_facility"]}
      }
    },
    "problem": {
      "type": "object",
      "additionalProperties": false,
      "required": ["problem_type", "summary", "asset_label"],
      "properties": {
        "problem_type": {"type": "string", "enum": ["street_lighting", "signage", "roads", "waste", "water", "public_transport", "accessibility", "public_space", "service_access", "other"]},
        "summary": {"type": "string", "minLength": 1, "maxLength": 2000},
        "asset_label": {"type": "string", "minLength": 1, "maxLength": 240},
        "observed_at": {"type": "string", "format": "date-time"}
      }
    },
    "evidence": {
      "type": "array",
      "minItems": 1,
      "maxItems": 20,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["source_url", "source_type", "accessed_at", "supports"],
        "properties": {
          "source_url": {"type": "string", "format": "uri"},
          "source_type": {"type": "string", "enum": ["official_record", "official_service_page", "public_report", "service_status", "news", "community_report", "direct_observation", "other"]},
          "published_at": {"type": "string", "format": "date-time"},
          "requested_at": {"type": "string", "format": "date-time"},
          "source_updated_at": {"type": "string", "format": "date-time"},
          "observed_at": {"type": "string", "format": "date-time"},
          "accessed_at": {"type": "string", "format": "date-time"},
          "supports": {"type": "string", "minLength": 1, "maxLength": 500},
          "reliability": {"type": "number", "minimum": 0, "maximum": 1}
        }
      }
    },
    "routing": {
      "type": "object",
      "additionalProperties": false,
      "required": ["service_name", "basis", "official_url", "contact_method", "confidence"],
      "properties": {
        "service_name": {"type": "string", "minLength": 1, "maxLength": 200},
        "basis": {"type": "string", "minLength": 1, "maxLength": 800},
        "official_url": {"type": "string", "format": "uri"},
        "contact_method": {"type": "string", "minLength": 1, "maxLength": 160},
        "confidence": {"type": "number", "minimum": 0, "maximum": 1}
      }
    },
    "duplicate_check": {
      "type": "object",
      "additionalProperties": false,
      "required": ["checked_at", "scope", "result"],
      "properties": {
        "checked_at": {"type": "string", "format": "date-time"},
        "scope": {"type": "string", "minLength": 1, "maxLength": 800},
        "result": {"type": "string", "enum": ["no_match_found", "match_found", "unknown"]},
        "public_references": {
          "type": "array",
          "maxItems": 10,
          "items": {"type": "string", "format": "uri"}
        }
      }
    },
    "project_check": {
      "type": "object",
      "additionalProperties": false,
      "required": ["checked_at", "scope", "result"],
      "properties": {
        "checked_at": {"type": "string", "format": "date-time"},
        "scope": {"type": "string", "minLength": 1, "maxLength": 800},
        "result": {"type": "string", "enum": ["no_active_project", "active_project", "unknown"]},
        "public_references": {
          "type": "array",
          "maxItems": 10,
          "items": {"type": "string", "format": "uri"}
        }
      }
    },
    "confidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["overall", "basis"],
      "properties": {
        "overall": {"type": "number", "minimum": 0, "maximum": 1},
        "basis": {"type": "string", "minLength": 1, "maxLength": 800}
      }
    },
    "proposed_action": {
      "type": "object",
      "additionalProperties": false,
      "required": ["requested_action", "draft", "channel"],
      "properties": {
        "requested_action": {"type": "string", "minLength": 1, "maxLength": 400},
        "draft": {"type": "string", "minLength": 1, "maxLength": 4000},
        "channel": {"type": "string", "minLength": 1, "maxLength": 160}
      }
    },
    "privacy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["contains_personal_data", "redaction_reviewed", "data_to_share", "participant_controlled_fields"],
      "properties": {
        "contains_personal_data": {"const": false},
        "redaction_reviewed": {"const": true},
        "data_to_share": {"type": "array", "items": {"type": "string", "maxLength": 160}},
        "participant_controlled_fields": {"type": "array", "items": {"type": "string", "maxLength": 160}}
      }
    },
    "human_confirmation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["required", "confirmed", "fields_reviewed"],
      "properties": {
        "required": {"const": true},
        "confirmed": {"type": "boolean"},
        "confirmed_at": {"type": "string", "format": "date-time"},
        "confirmed_by": {"type": "string", "enum": ["participant"]},
        "fields_reviewed": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "enum": ["recipient", "content", "evidence", "data_disclosure", "duplicate_risk"]}
        }
      }
    },
    "tracking": {
      "type": "object",
      "additionalProperties": false,
      "required": ["client_signal_id", "idempotency_key", "requested_receipt"],
      "properties": {
        "client_signal_id": {"type": "string", "pattern": "^cog-signal-[a-z0-9-]+$"},
        "idempotency_key": {"type": "string", "minLength": 1, "maxLength": 200},
        "requested_receipt": {"const": true}
      }
    }
  },
  "allOf": [
    {
      "if": {"properties": {"message_type": {"const": "signal_preview"}}},
      "then": {"properties": {"human_confirmation": {"properties": {"confirmed": {"const": false}}}}}
    },
    {
      "if": {"properties": {"message_type": {"const": "submit_civic_signal"}}},
      "then": {
        "properties": {
          "duplicate_check": {"properties": {"result": {"const": "no_match_found"}}},
          "project_check": {"properties": {"result": {"const": "no_active_project"}}},
          "human_confirmation": {
            "properties": {
              "confirmed": {"const": true}
            },
            "required": ["confirmed_at", "confirmed_by"]
          }
        }
      }
    }
  ]
}
